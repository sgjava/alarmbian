        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <spring-boot.run.jvmArguments>--enable-native-access=ALL-UNNAMED -Djava.library.path=${user.home}/opencv/build/lib -agentpath:${user.home}/netbeans/profiler/lib/deployed/jdk16/linux-amd64/libprofilerinterface.so=${user.home}/netbeans/profiler/lib,5140,10</spring-boot.run.jvmArguments>
