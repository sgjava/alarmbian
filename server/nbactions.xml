            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <spring-boot.run.jvmArguments>--enable-native-access=ALL-UNNAMED -Djava.library.path=${user.home}/opencv/build/lib -agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</spring-boot.run.jvmArguments>
            <jpda.listen>true</jpda.listen>
